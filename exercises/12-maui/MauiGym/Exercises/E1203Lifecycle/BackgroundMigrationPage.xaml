<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiGym.Exercises.E1203Lifecycle.BackgroundMigrationPage"
             Title="Background migration">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label x:Name="ProgressLabel" Text="No migration running" FontAttributes="Bold" />
        <ProgressBar x:Name="Progress" />
        <Button x:Name="StartButton" Text="Start migration (40 files)" Clicked="OnStartClicked" HorizontalOptions="Start" />
        <Label x:Name="StateFileLabel" FontSize="12" />
    </VerticalStackLayout>
</ContentPage>
