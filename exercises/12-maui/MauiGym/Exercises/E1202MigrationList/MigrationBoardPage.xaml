<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiGym.Exercises.E1202MigrationList"
             x:Class="MauiGym.Exercises.E1202MigrationList.MigrationBoardPage"
             x:DataType="local:MigrationBoardViewModel"
             Title="Board">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="8">
        <Button Text="Simulate progress" Command="{Binding SimulateProgressCommand}" HorizontalOptions="Start" />
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Migrations}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:MigrationRow">
                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="8" ColumnSpacing="12">
                            <Label Text="{Binding CustomerName}" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding State}" />
                            <Label Grid.Column="2" Text="{Binding Files, StringFormat='{0} files'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
