<UserControl x:Class="MigrationKit.Wpf.MigrationStatusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MigrationKit.Wpf">
    <UserControl.DataContext>
        <vm:MigrationStatusViewModel />
    </UserControl.DataContext>
    <StackPanel Margin="12">
        <TextBlock x:Name="StatusText" FontWeight="Bold" Text="{Binding StatusText}" />
        <TextBlock x:Name="FilesText" Margin="0,6,0,0" Text="{Binding FilesUploaded}" />
        <ProgressBar x:Name="ProgressBar" Height="16" Margin="0,6,0,0" Minimum="0" Maximum="100"
                     Value="{Binding Percent, Mode=OneTime}" />
    </StackPanel>
</UserControl>
