<Window x:Class="MigrationKit.Desktop.MigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Migration" Height="260" Width="520">
    <StackPanel Margin="16">
        <TextBlock Text="Folder" />
        <TextBox x:Name="FolderBox" Text="C:\Projects\Northwind\Export" />

        <TextBlock Text="API key" Margin="0,8,0,0" />
        <TextBox x:Name="ApiKeyBox" Text="mig-live-8f21c6d4e7b9" />

        <ProgressBar x:Name="Progress" Height="22" Minimum="0" Maximum="100" Margin="0,16,0,0" />
        <TextBlock x:Name="CurrentFile" Margin="0,8,0,0" />
        <TextBlock x:Name="Elapsed" Margin="0,4,0,0" />

        <Button x:Name="StartButton" Content="Start migration" Click="RunMigration" Margin="0,16,0,0" />
    </StackPanel>
</Window>
