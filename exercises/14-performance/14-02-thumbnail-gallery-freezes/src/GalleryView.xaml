<UserControl x:Class="MigrationKit.Gallery.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="TileTemplate">
            <StackPanel Width="176" Margin="8">
                <Border Background="#EEEEEE" Height="120">
                    <Image Source="{Binding Thumbnail}" Width="160" Stretch="Uniform" />
                </Border>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="Tiles"
                      ItemsSource="{Binding Items}"
                      ItemTemplate="{StaticResource TileTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
