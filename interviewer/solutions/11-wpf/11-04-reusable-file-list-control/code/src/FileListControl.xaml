<UserControl x:Class="MigrationKit.Wpf.FileListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!--
        Everything the control shows comes from its own dependency properties, so any application can
        supply the data. Colours come from theme resources with a fallback, so hosts can restyle it.
    -->
    <ListView x:Name="Files"
              ItemsSource="{Binding ItemsSource, ElementName=Root}"
              SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"
              Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
              BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
              MouseDoubleClick="OnRowDoubleClick">
        <ListView.View>
            <GridView>
                <GridViewColumn Header="{Binding NameColumnHeader, ElementName=Root}" Width="320" DisplayMemberBinding="{Binding Name}" />
                <GridViewColumn Header="{Binding StatusColumnHeader, ElementName=Root}" Width="120" DisplayMemberBinding="{Binding Status}" />
            </GridView>
        </ListView.View>
    </ListView>
</UserControl>
